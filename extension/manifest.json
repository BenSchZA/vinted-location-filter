{
  "manifest_version": 3,
  "name": "Vinted Location Filter",
  "version": "0.1.0",
  "description": "Filter Vinted search results by the seller's country and show where every listing ships from.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.vinted.co.uk/*",
    "*://*.vinted.com/*",
    "*://*.vinted.fr/*",
    "*://*.vinted.de/*",
    "*://*.vinted.es/*",
    "*://*.vinted.it/*",
    "*://*.vinted.nl/*",
    "*://*.vinted.be/*",
    "*://*.vinted.at/*",
    "*://*.vinted.ie/*",
    "*://*.vinted.pt/*",
    "*://*.vinted.fi/*",
    "*://*.vinted.gr/*",
    "*://*.vinted.lu/*",
    "*://*.vinted.sk/*",
    "*://*.vinted.si/*",
    "*://*.vinted.hr/*",
    "*://*.vinted.lt/*",
    "*://*.vinted.lv/*",
    "*://*.vinted.ee/*",
    "*://*.vinted.pl/*",
    "*://*.vinted.cz/*",
    "*://*.vinted.se/*",
    "*://*.vinted.dk/*",
    "*://*.vinted.hu/*",
    "*://*.vinted.ro/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.vinted.co.uk/*",
        "*://*.vinted.com/*",
        "*://*.vinted.fr/*",
        "*://*.vinted.de/*",
        "*://*.vinted.es/*",
        "*://*.vinted.it/*",
        "*://*.vinted.nl/*",
        "*://*.vinted.be/*",
        "*://*.vinted.at/*",
        "*://*.vinted.ie/*",
        "*://*.vinted.pt/*",
        "*://*.vinted.fi/*",
        "*://*.vinted.gr/*",
        "*://*.vinted.lu/*",
        "*://*.vinted.sk/*",
        "*://*.vinted.si/*",
        "*://*.vinted.hr/*",
        "*://*.vinted.lt/*",
        "*://*.vinted.lv/*",
        "*://*.vinted.ee/*",
        "*://*.vinted.pl/*",
        "*://*.vinted.cz/*",
        "*://*.vinted.se/*",
        "*://*.vinted.dk/*",
        "*://*.vinted.hu/*",
        "*://*.vinted.ro/*"
      ],
      "js": [
        "src/origins.js",
        "src/api.js",
        "src/settings.js",
        "src/lookup.js",
        "src/grid.js",
        "src/ui.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Vinted Location Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
